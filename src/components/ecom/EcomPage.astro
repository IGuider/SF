---
import BlogSection from '../common/BlogSection.astro';
import CalculatorSection from './CalculatorSection.astro';
import ClientCasesSection from './ClientCasesSection.astro';
import FaqSection from '../common/FaqSection.astro';
import FeatureCardsSection from './FeatureCardsSection.astro';
import HeroSection from '../common/HeroSection.astro';
import StepsSection from '../common/StepsSection.astro';
import AboutSection from '../common/AboutSection.astro';
import ProductsSection from './ProductsSection.astro';
import heroBgMobile1 from '../../assets/hero-bg-mobile-1.png';
import heroWarehouse from '../../assets/hero.jpg';

const ecomSteps = [
	{
		id: 'request',
		number: '01',
		title: 'Заявка',
		descriptionLines: ['Оставьте заявку на\u00A0сайте:', 'потребуется всего', '2\u00A0минуты'],
	},
	{
		id: 'review',
		number: '02',
		title: 'Рассмотрение',
		descriptionLines: ['Проверим данные', 'и\u00A0подготовим предложение', 'в\u00A0течение 1\u00A0дня'],
	},
	{
		id: 'offer',
		number: '03',
		title: 'Предложение',
		descriptionLines: ['Согласуем лимит', 'кредитной линии, срок', 'и\u00A0график финансирования'],
	},
	{
		id: 'payout',
		number: '04',
		title: 'Выдача',
		descriptionLines: ['После подписания', 'документов средства', 'поступят день-в-день'],
		ctaLabel: 'Оставить заявку',
	},
];

const ecomAboutParagraphs = [
	'Возобновляемая кредитная линия помогает продавцам маркетплейсов поддерживать оборотный капитал без постоянного оформления новых займов. Средства можно использовать для закупки товара, оплаты логистики, рекламы, подготовки к сезонному спросу и покрытия кассовых разрывов до поступления выплат от маркетплейсов. Такой формат финансирования особенно востребован у продавцов Wildberries, Ozon, Яндекс Маркета и других площадок',
	'SimpleFinance помогает получить финансирование для маркетплейсов полностью онлайн. Платформа объединяет финансовые решения для бизнеса, позволяя подобрать оптимальный лимит, срок кредитной линии и график погашения. Это помогает предпринимателям быстрее масштабировать продажи, эффективнее управлять оборотными средствами и развивать бизнес без длительного ожидания выплат от маркетплейсов',
];
---

<main>
	<div transition:name="page-content-top" transition:animate="fade">
		<HeroSection
			variant="ecom"
			badges={['Wildberries', 'Ozon', 'Золотое яблоко', 'Lamoda']}
			titleLines={['Финансирование для роста бизнеса', 'на маркетплейсах']}
			descriptionLines={[
				'Возобновляемая кредитная линия для\u00A0продавцов',
				'Wildberries, Ozon, Яндекс Маркета и\u00A0других',
				'маркетплейсов. До\u00A0150\u00A0млн\u00A0₽, без\u00A0залога, онлайн',
			]}
			descriptionBreaksDesktopOnly
			buttonLabel="Узнать условия"
			image={heroWarehouse}
			mobileGlowBottom={heroBgMobile1}
		/>
		<FeatureCardsSection />
	</div>
	<CalculatorSection />
	<div transition:name="page-content-bottom" transition:animate="fade">
		<ProductsSection />
		<ClientCasesSection />
		<StepsSection
			descriptionLines={['Оформление полностью онлайн — от\u00A0подачи заявки до\u00A0открытия кредитной линии и\u00A0получения средств']}
			steps={ecomSteps}
		/>
		<BlogSection />
		<FaqSection />
		<AboutSection paragraphs={ecomAboutParagraphs} ariaLabel="О финансировании для маркетплейсов" />
	</div>
</main>
