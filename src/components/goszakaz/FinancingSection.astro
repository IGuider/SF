---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import ConsultationDialogTrigger from '../common/ConsultationDialogTrigger.astro';
import Button from '../ui/Button.astro';
import tab1BgImage from '../../assets/tab1-bg.png';
import tab1BgMobileImage from '../../assets/tab1-bg-m.png';
import tab2BgImage from '../../assets/tab2-bg.png';
import tab2BgMobileImage from '../../assets/tab2-bg-m.png';
import tab3BgImage from '../../assets/tab3-bg.png';
import tab3BgMobileImage from '../../assets/tab3-bg-m.png';
import tab4BgImage from '../../assets/tab4-bg.png';
import tab4BgMobileImage from '../../assets/tab4-bg-m.png';
import '../../styles/components/goszakaz/financing-section.scss';

const financingImageMap = {
	'tender-loan': {
		image: tab1BgImage,
		mobileImage: tab1BgMobileImage,
	},
	'bank-guarantee': {
		image: tab2BgImage,
		mobileImage: tab2BgMobileImage,
	},
	'credit-line': {
		image: tab3BgImage,
		mobileImage: tab3BgMobileImage,
	},
	'guarantee-commission-loan': {
		image: tab4BgImage,
		mobileImage: tab4BgMobileImage,
	},
} as const satisfies Record<string, { image: ImageMetadata; mobileImage: ImageMetadata }>;

type FinancingTab = {
	id: string;
	label: string;
	summaryTitle: string;
	facts: string[];
	detailsTitle: string;
	description: string;
	image: ImageMetadata;
	mobileImage: ImageMetadata;
	modifier: keyof typeof financingImageMap;
};

const financingTabs: FinancingTab[] = (await getCollection('goszakazFinancingTabs'))
	.sort((left, right) => left.data.order - right.data.order)
	.map((item) => ({
		id: item.id,
		...item.data,
		...financingImageMap[item.data.modifier],
	}));
---

<section class="procurement-financing section" id="financing" aria-labelledby="procurement-financing-title" data-financing-tabs-root>
	<div class="container">
		<div class="procurement-financing__content">
			<div class="procurement-financing__header section-header">
				<h2 class="section-title" id="procurement-financing-title">Финансирование для госзаказа</h2>
				<p class="procurement-financing__description">
					На платформе доступны финансовые продукты для разных задач участников закупок.<br />
					Выберите подходящее решение в зависимости от этапа работы с контрактом
				</p>
			</div>

			<div class="procurement-financing__body" data-financing-tabs-body>
				<div class="procurement-financing__tabs" role="tablist" aria-label="Виды финансирования для госзаказа">
					{
						financingTabs.map((tab, index) => (
							<button
								class="procurement-financing__tab"
								id={`procurement-financing-tab-${tab.id}`}
								type="button"
								role="tab"
								aria-selected={index === 0 ? 'true' : 'false'}
								aria-controls={`procurement-financing-panel-${tab.id}`}
								tabindex={index === 0 ? 0 : -1}
								data-financing-tab={tab.id}
							>
								{tab.label}
							</button>
						))
					}
				</div>

				{
					financingTabs.map((tab, index) => (
						<div
							class="procurement-financing__panel"
							id={`procurement-financing-panel-${tab.id}`}
							role="tabpanel"
							aria-labelledby={`procurement-financing-tab-${tab.id}`}
							data-financing-panel={tab.id}
							data-state={index === 0 ? 'active' : 'idle'}
							hidden={index !== 0}
						>
							<div class="procurement-financing__cards">
								<article class="procurement-financing-card procurement-financing-card--summary">
									<div class="procurement-financing-card__content">
										<h3 class="procurement-financing-card__title">{tab.summaryTitle}</h3>
										<ul class="procurement-financing-card__facts" aria-label={`Условия: ${tab.summaryTitle}`}>
											{tab.facts.map((fact) => (
												<li class="procurement-financing-card__fact">{fact}</li>
											))}
										</ul>
									</div>

									<Image
										class:list={[
											'procurement-financing-card__image',
											'procurement-financing-card__image--desktop',
											`procurement-financing-card__image--${tab.modifier}`,
										]}
										src={tab.image}
										alt=""
										loading={index === 0 ? 'eager' : 'lazy'}
										decoding="async"
									/>

									<Image
										class:list={[
											'procurement-financing-card__image',
											'procurement-financing-card__image--mobile',
											`procurement-financing-card__image--${tab.modifier}`,
										]}
										src={tab.mobileImage}
										alt=""
										loading="lazy"
										decoding="async"
									/>
								</article>

								<article class="procurement-financing-card procurement-financing-card--details">
									<div class="procurement-financing-card__content">
										<h3 class="procurement-financing-card__title">{tab.detailsTitle}</h3>
										<p class="procurement-financing-card__text">{tab.description}</p>
										<ConsultationDialogTrigger>
											<Button class="procurement-financing-card__button" variant="secondary" size="xl">
												Оставить заявку
											</Button>
										</ConsultationDialogTrigger>
									</div>
								</article>
							</div>
						</div>
					))
				}
			</div>
		</div>
	</div>
</section>

<script>
	import '../../scripts/goszakaz/financing-tabs.ts';
</script>
