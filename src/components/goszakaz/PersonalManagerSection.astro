---
import { Image } from 'astro:assets';
import managerImage from '../../assets/manager-panel-bg.png';
import '../../styles/components/goszakaz/manager-section.scss';
---

<section class="procurement-manager section" id="manager" aria-labelledby="procurement-manager-title">
	<div class="container">
		<div class="procurement-manager__header section-header">
			<h2 class="section-title" id="procurement-manager-title">Персональный менеджер на весь процесс</h2>
		</div>

		<div class="procurement-manager__panel">
			<div class="procurement-manager__visual" aria-hidden="true">
				<Image
					class="procurement-manager__image media-fill media-fit-cover"
					src={managerImage}
					alt=""
					loading="lazy"
					decoding="async"
				/>
			</div>

			<div class="procurement-manager__content">
				<h3 class="procurement-manager__title">
					От заявки до исполнения контракта<br />
					вас ведет один человек
				</h3>
				<p class="procurement-manager__text">
					<strong>Подберет инструмент, рассчитает условия, поможет с документами</strong> и проследит за сроками.
					На связи там, где удобно вам — в мессенджере, по телефону или почте
				</p>
			</div>
		</div>
	</div>
</section>
