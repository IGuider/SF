---
import '../../styles/components/goszakaz/support-section.scss';

const supportItems = [
	{
		title: 'Заем на исполнение контракта (КИК)',
		heading: 'Победил в тендере, но нет денег на исполнение контракта?',
		accent: 'Профинансируем 70% от суммы,',
		text: ' если нужны свободные деньги на поставку товара или чтобы начать работы',
	},
	{
		title: 'Тендерный заем',
		heading: 'Нужны деньги на обеспечение заявки?',
		accent: 'Профинансируем до 150 млн ₽,',
		text: ' чтобы заблокировать деньги на спецсчете или внести обеспечение',
	},
	{
		title: 'Банковская гарантия',
		heading: 'Нужна банковская гарантия?',
		accent: 'Предоставим до 3 млрд ₽.',
		text: ' Это дешевле, чем замораживать средства, требуется лишь оплата комиссии за выпуск',
	},
	{
		title: 'Заем на пополнение оборотных средств',
		heading: 'Нужны оборотные средства?',
		accent: 'Предоставим до 65 млн ₽',
		text: ' на обязательные платежи. Не прерывайте свой бизнес из-за кассового разрыва',
	},
];
---

<section class="procurement-support section" id="products" aria-labelledby="procurement-support-title">
	<div class="container">
		<div class="section-header section-header--compact">
			<h2 class="procurement-support__title section-title" id="procurement-support-title">Поддержка на любом этапе</h2>
		</div>

		<div class="procurement-support__grid">
			{supportItems.map((item) => (
				<article class="procurement-support-card">
					<div class="procurement-support-card__content">
						<p class="procurement-support-card__eyebrow">{item.title}</p>
						<h3 class="procurement-support-card__title">{item.heading}</h3>
						<p class="procurement-support-card__text">
							<span>{item.accent}</span>{item.text}
						</p>
					</div>
				</article>
			))}
		</div>
	</div>
</section>
