---
import { getCollection } from 'astro:content';
import Badge from '../ui/Badge.astro';
import '../../styles/components/goszakaz/support-section.scss';

const supportItems = (await getCollection('goszakazSupportItems'))
	.sort((left, right) => left.data.order - right.data.order)
	.map((item) => item.data);
---

<section class="procurement-support section" id="products" aria-labelledby="procurement-support-title">
	<div class="container">
		<div class="procurement-support__header section-header section-header--compact">
			<h2 class="procurement-support__title section-title" id="procurement-support-title">Поддержка на любом этапе</h2>
			<p class="procurement-support__description section-description">
				Подберите финансовое решение для любого этапа закупки —<br />
				от подачи заявки до исполнения государственного или коммерческого контракта
			</p>
		</div>

		<div class="procurement-support__grid">
			{supportItems.map((item) => (
				<article class="procurement-support-card">
					<div class="procurement-support-card__content">
						<Badge as="p" variant="surface-white" class="procurement-support-card__eyebrow">{item.title}</Badge>
						<h3 class="procurement-support-card__title">{item.heading}</h3>
						<p class="procurement-support-card__text">
							<span>{item.accent}</span>{item.text}
						</p>
					</div>
				</article>
			))}
		</div>
	</div>
</section>
