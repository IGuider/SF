---
import { getCollection } from 'astro:content';
import HeroSection from '../common/HeroSection.astro';
import FinancingSection from './FinancingSection.astro';
import WhySimpleFinanceSection from './WhySimpleFinanceSection.astro';
import PersonalManagerSection from '../common/PersonalManagerSection.astro';
import ProcurementSupportSection from './ProcurementSupportSection.astro';
import StepsSection from '../common/StepsSection.astro';
import UsefulArticlesSection from '../common/UsefulArticlesSection.astro';
import LeadFormSection from '../common/LeadFormSection.astro';
import FaqSection from '../common/FaqSection.astro';
import AboutSection from '../common/AboutSection.astro';
import heroGoszakazImage from '../../assets/hero-goszakaz.jpg';

const [usefulArticleEntries, heroBadgeEntries] = await Promise.all([
	getCollection('goszakazUsefulArticles'),
	getCollection('goszakazHeroBadges'),
]);

const usefulArticleSlugs = usefulArticleEntries
	.sort((left, right) => left.data.order - right.data.order)
	.map((item) => item.data.slug);
const heroBadges = heroBadgeEntries
	.sort((left, right) => left.data.order - right.data.order)
	.map((item) => item.data.label);

const goszakazSteps = [
	{
		id: 'goszakaz-request',
		number: '01',
		title: 'Заявка',
		description: 'Оставьте заявку на сайте — 2 минуты на заполнение',
	},
	{
		id: 'goszakaz-review',
		number: '02',
		title: 'Рассмотрение',
		description: 'В течение 1 дня подготовим персональные условия',
	},
	{
		id: 'goszakaz-offer',
		number: '03',
		title: 'Предложение',
		description: 'Получите лимит, ставку и срок',
	},
	{
		id: 'goszakaz-disbursement',
		number: '04',
		title: 'Выдача',
		description: 'Средства поступают на счет день в день',
		ctaLabel: 'Оставить заявку',
	},
];

const goszakazAboutParagraphs = [
	'Финансирование для участия в госзакупках позволяет компаниям получить необходимые средства для работы с государственными и коммерческими заказчиками без отвлечения собственного оборотного капитала. Такой инструмент помогает своевременно участвовать в закупках, исполнять требования заказчика и сохранять финансовую устойчивость бизнеса',
	'Решение подходит поставщикам, подрядчикам, производителям и сервисным компаниям, работающим по 44-ФЗ, 223-ФЗ, 185-ФЗ, 615-ПП, а также участвующим в коммерческих закупках. Финансирование может использоваться для обеспечения заявки, исполнения контракта и покрытия расходов, связанных с выполнением обязательств перед заказчиком',
	'SimpleFinance помогает подобрать оптимальный вариант финансирования для участия в госзакупках с учетом параметров закупки, финансового состояния компании и сроков реализации проекта. Заявку можно подать онлайн, а решение принимается в кратчайшие сроки',
];
---

<main transition:name="page-content" transition:animate="fade">
	<HeroSection
		variant="goszakaz"
		titleLines={['Финансирование', 'для госзакупок', 'за 1 день без залога']}
		descriptionLines={['Тендерные займы, банковские гарантии', 'и контрактное финансирование по 44-ФЗ и 223-ФЗ']}
		badges={heroBadges}
		badgesPosition="afterText"
		badgesLabel="Преимущества финансирования"
		badgeVariant="outline-primary"
		buttonLabel="Подобрать решение"
		buttonVariant="secondary"
		image={heroGoszakazImage}
	/>
	<ProcurementSupportSection />
	<FinancingSection />
	<WhySimpleFinanceSection />
	<StepsSection
		title="Как проходит оформление тендерного займа"
		descriptionLines={['Получить финансирование можно полностью онлайн —', 'от подачи заявки до получения денежных средств']}
		steps={goszakazSteps}
	/>
	<PersonalManagerSection />
	<UsefulArticlesSection
		id="procurement-useful"
		title="Полезное для участников госзакупок"
		postSlugs={usefulArticleSlugs}
	/>
	<LeadFormSection
		id="procurement-lead-form"
		title="Подберем решение под ваш бизнес"
		fields={['name', 'phone', 'email', 'inn']}
		submitLabel="Оставить заявку"
		fieldOverrides={{
			name: { label: 'ФИО', required: false },
			inn: { label: 'ИНН организации', required: false, validate: true },
		}}
	/>
	<AboutSection paragraphs={goszakazAboutParagraphs} ariaLabel="О финансировании для госзакупок" />
	<FaqSection collection="goszakazFaq" />
</main>
