---
import { getCollection } from 'astro:content';
import HeroSection from '../common/HeroSection.astro';
import FinancingSection from './FinancingSection.astro';
import WhySimpleFinanceSection from './WhySimpleFinanceSection.astro';
import PersonalManagerSection from '../common/PersonalManagerSection.astro';
import ProcurementSupportSection from './ProcurementSupportSection.astro';
import StepsSection from '../common/StepsSection.astro';
import UsefulArticlesSection from '../common/UsefulArticlesSection.astro';
import LeadFormSection from '../common/LeadFormSection.astro';
import FaqSection from '../common/FaqSection.astro';
import heroGoszakazImage from '../../assets/hero-goszakaz.jpg';

const [usefulArticleEntries, heroBadgeEntries] = await Promise.all([
	getCollection('goszakazUsefulArticles'),
	getCollection('goszakazHeroBadges'),
]);

const usefulArticleSlugs = usefulArticleEntries
	.sort((left, right) => left.data.order - right.data.order)
	.map((item) => item.data.slug);
const heroBadges = heroBadgeEntries
	.sort((left, right) => left.data.order - right.data.order)
	.map((item) => item.data.label);
---

<main transition:name="page-content" transition:animate="fade">
	<HeroSection
		variant="goszakaz"
		titleLines={['Финансирование,', 'для госзакупок —', 'за 1 день, без залога']}
		descriptionLines={['Тендерный займ, банковская гарантия', 'и финансирование контракта']}
		badges={heroBadges}
		badgesPosition="afterText"
		badgesLabel="Преимущества финансирования"
		badgeVariant="outline-primary"
		buttonLabel="Подобрать решение"
		buttonVariant="secondary"
		image={heroGoszakazImage}
	/>
	<ProcurementSupportSection />
	<FinancingSection />
	<WhySimpleFinanceSection />
	<StepsSection />
	<PersonalManagerSection />
	<UsefulArticlesSection
		id="procurement-useful"
		title="Полезное для участников госзакупок"
		postSlugs={usefulArticleSlugs}
	/>
	<LeadFormSection
		id="procurement-lead-form"
		title="Подберем решение под ваш бизнес"
		fields={['name', 'phone', 'email', 'inn']}
		submitLabel="Оставить заявку"
		fieldOverrides={{
			name: { label: 'ФИО', required: false },
			inn: { label: 'ИНН организации', required: false, validate: true },
		}}
	/>
	<FaqSection collection="goszakazFaq" />
</main>
