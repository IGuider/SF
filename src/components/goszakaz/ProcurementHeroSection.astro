---
import LeadForm from '../common/LeadForm.astro';
import ConsultationDialogTrigger from '../common/ConsultationDialogTrigger.astro';
import Button from '../ui/Button.astro';
import '../../styles/components/goszakaz/hero-section.scss';

const badges = ['35+ банков-партнеров', 'до 500 млн ₽', 'от 3% в месяц'];

const productOptions = [
	'Тендерный заем',
	'Банковская гарантия',
	'Возобновляемая кредитная линия',
	'Заем на оплату комиссии БГ',
];
---

<section class="procurement-hero section" id="hero" data-lead-form-root>
	<div class="container">
		<div class="procurement-hero__layout">
			<div class="procurement-hero__content">
				<h1 class="procurement-hero__title">
					Финансирование,<br>
					для госзакупок —<br>
					за 1 день, без залога
				</h1>
				<p class="procurement-hero__description">
					Тендерный займ, банковская гарантия<br />
					и финансирование контракта
				</p>
				<ul class="procurement-hero__badges" aria-label="Преимущества финансирования">
					{badges.map((badge) => <li class="procurement-hero__badge">{badge}</li>)}
				</ul>
				<div class="procurement-hero__mobile-action">
					<ConsultationDialogTrigger>
						<Button variant="secondary" size="md" class="procurement-hero__mobile-button">
							Подобрать решение
						</Button>
					</ConsultationDialogTrigger>
				</div>
			</div>

			<div class="procurement-hero__panel" data-lead-form-panel>
				<div class="procurement-hero__panel-content">
					<h2 class="procurement-hero__form-title">Получить финансирование</h2>
					<LeadForm
						block="procurement-hero"
						fields={['phone', 'product']}
						submitLabel="Подобрать решение"
						submitClass="procurement-hero__submit"
						submitVariant="secondary"
						submitSize="xl"
						productOptions={productOptions}
						productMenuId="procurement-hero-product-options"
					/>
				</div>

				<div class="procurement-hero__success" data-lead-form-success data-state="hidden" aria-live="polite">
					<div class="procurement-hero__success-card">
						<button
							type="button"
							class="procurement-hero__success-close"
							data-lead-form-success-close
							aria-label="Закрыть сообщение"
						>
							<svg
								class="procurement-hero__success-close-icon"
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="2"
								stroke-linecap="round"
								stroke-linejoin="round"
								aria-hidden="true"
							>
								<path d="M18 6 6 18" />
								<path d="m6 6 12 12" />
							</svg>
						</button>
						<h3 class="procurement-hero__success-title">Спасибо!</h3>
						<p class="procurement-hero__success-text">
							Ваша заявка отправлена. Менеджер свяжется с вами в ближайшее время.
						</p>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>

<script>
	import '../../scripts/common/lead-form.ts';
</script>
