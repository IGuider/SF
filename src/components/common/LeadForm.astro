---
import Button from '../ui/Button.astro';

export type LeadFormField = 'name' | 'phone' | 'email' | 'inn' | 'procurement' | 'message' | 'turnover' | 'product';

type TextLeadFormField = Exclude<LeadFormField, 'turnover' | 'product'>;
type LeadFormFieldOverride = Partial<{
	label: string;
	error: string;
	required: boolean;
	validate: boolean;
	maxlength: string;
	pattern: string;
}>;

export type LeadFormFieldOverrides = Partial<Record<TextLeadFormField, LeadFormFieldOverride>>;

interface Props {
	block: string;
	fields: LeadFormField[];
	submitLabel: string;
	submitClass?: string;
	submitVariant?: 'primary' | 'secondary' | 'outline';
	submitSize?: 'md' | 'lg' | 'xl';
	turnoverOptions?: string[];
	productOptions?: string[];
	turnoverMenuId?: string;
	productMenuId?: string;
	button?: 'ui' | 'native';
	fieldOverrides?: LeadFormFieldOverrides;
}

const {
	block,
	fields,
	submitLabel,
	submitClass,
	submitVariant = 'secondary',
	submitSize = 'lg',
	turnoverOptions = [],
	productOptions = [],
	turnoverMenuId = `${block}-turnover-options`,
	productMenuId = `${block}-product-options`,
	button = 'ui',
	fieldOverrides = {},
} = Astro.props;

const fieldConfig: Record<TextLeadFormField, {
	id: string | undefined;
	name: string;
	type: string;
	autocomplete: string;
	inputmode: 'tel' | 'email' | 'numeric' | undefined;
	label: string;
	error: string;
	maxlength: string | undefined;
	pattern: string | undefined;
	dataLeadPhone: boolean;
	required: boolean;
	validate: boolean;
	multiline: boolean;
}> = {
	name: {
		id: block === 'consultation-dialog' ? 'consultation-name' : undefined,
		name: 'name',
		type: 'text',
		autocomplete: 'name',
		inputmode: undefined,
		label: 'ФИО',
		error: '',
		maxlength: '120',
		pattern: undefined,
		dataLeadPhone: false,
		required: false,
		validate: false,
		multiline: false,
	},
	phone: {
		id: block === 'consultation-dialog' ? 'consultation-phone' : undefined,
		name: 'phone',
		type: 'tel',
		autocomplete: 'tel',
		inputmode: 'tel',
		label: 'Телефон',
		error: 'Необходимо заполнить поле',
		maxlength: '18',
		pattern: undefined,
		dataLeadPhone: true,
		required: true,
		validate: false,
		multiline: false,
	},
	email: {
		id: block === 'consultation-dialog' ? 'consultation-email' : undefined,
		name: 'email',
		type: 'email',
		autocomplete: 'email',
		inputmode: 'email',
		label: 'Почта',
		error: 'Введите корректную почту',
		maxlength: undefined,
		pattern: undefined,
		dataLeadPhone: false,
		required: true,
		validate: false,
		multiline: false,
	},
	inn: {
		id: block === 'consultation-dialog' ? 'consultation-inn' : undefined,
		name: 'inn',
		type: 'text',
		autocomplete: 'off',
		inputmode: 'numeric',
		label: 'ИНН организации',
		error: 'Введите корректный ИНН',
		maxlength: '12',
		pattern: '[0-9]{10}|[0-9]{12}',
		dataLeadPhone: false,
		required: false,
		validate: true,
		multiline: false,
	},
	procurement: {
		id: undefined,
		name: 'procurement',
		type: 'text',
		autocomplete: 'off',
		inputmode: undefined,
		label: 'Закупка (название или номер)',
		error: '',
		maxlength: '180',
		pattern: undefined,
		dataLeadPhone: false,
		required: false,
		validate: false,
		multiline: false,
	},
	message: {
		id: undefined,
		name: 'message',
		type: 'text',
		autocomplete: 'off',
		inputmode: undefined,
		label: 'Поделитесь своим мнением',
		error: '',
		maxlength: '2000',
		pattern: undefined,
		dataLeadPhone: false,
		required: false,
		validate: false,
		multiline: true,
	},
};

const getFieldConfig = (field: TextLeadFormField) => ({
	...fieldConfig[field],
	...(fieldOverrides[field] ?? {}),
});

const selectFieldConfig = {
	turnover: {
		id: block === 'consultation-dialog' ? 'consultation-turnover' : undefined,
		name: 'turnover',
		label: 'Обороты',
		error: 'Необходимо заполнить поле',
		options: turnoverOptions,
		menuId: turnoverMenuId,
	},
	product: {
		id: undefined,
		name: 'product',
		label: 'Продукт',
		error: 'Необходимо заполнить поле',
		options: productOptions,
		menuId: productMenuId,
	},
};

const marketingConsentText =
	'Согласен(а) на получение рекламных и информационных материалов от ООО МКК «СимплФинанс»';
---

<form class={`${block}__form`} data-lead-form data-state="visible" novalidate>
	{fields.map((field) => {
		const config = field === 'turnover' || field === 'product' ? undefined : getFieldConfig(field);
		const selectConfig = field === 'turnover' || field === 'product' ? selectFieldConfig[field] : undefined;

		return selectConfig ? (
			<div
				class={`${block}__field ${block}__field--select`}
				data-dropdown-root
				data-required-field
				data-has-value="false"
				data-invalid="false"
			>
				<input id={selectConfig.id} type="hidden" name={selectConfig.name} required data-dropdown-input />
				<button
					type="button"
					class={`${block}__input ${block}__select`}
					data-dropdown-trigger
					aria-expanded="false"
					aria-controls={selectConfig.menuId}
				>
					<span class={`${block}__select-label`} data-dropdown-label></span>
				</button>
				<span class={`${block}__field-label ${block}__field-label--select`}>{selectConfig.label}</span>
				<span class={`${block}__select-icon`} aria-hidden="true">
					<svg viewBox="0 0 16 16" fill="none">
						<path
							d="M4 6L8 10L12 6"
							stroke="currentColor"
							stroke-width="1.6"
							stroke-linecap="round"
							stroke-linejoin="round"
						/>
					</svg>
				</span>
				<div
					class={`${block}__dropdown`}
					id={selectConfig.menuId}
					data-dropdown-menu
					data-state="closed"
					aria-hidden="true"
				>
					{selectConfig.options.map((option) => (
						<button
							type="button"
							class={`${block}__option`}
							data-dropdown-option
							data-selected="false"
							data-value={option}
						>
							{option}
						</button>
					))}
				</div>
				<span class={`${block}__error`}>{selectConfig.error}</span>
			</div>
		) : (
			<label
				class:list={[`${block}__field`, config.multiline && `${block}__field--textarea`]}
				data-required-field={config.required ? true : undefined}
				data-validate-field={config.validate ? true : undefined}
			>
				{config.multiline ? (
					<textarea
						id={config.id}
						class={`${block}__input ${block}__textarea`}
						name={config.name}
						autocomplete={config.autocomplete}
						placeholder=" "
						maxlength={config.maxlength}
						required={config.required ? true : undefined}
					></textarea>
				) : (
					<input
						id={config.id}
						class={`${block}__input`}
						name={config.name}
						type={config.type}
						autocomplete={config.autocomplete}
						inputmode={config.inputmode}
						placeholder=" "
						maxlength={config.maxlength}
						pattern={config.pattern}
						required={config.required ? true : undefined}
						data-lead-phone={config.dataLeadPhone ? true : undefined}
					/>
				)}
				<span class={`${block}__field-label`}>{config.label}</span>
				{config.error && <span class={`${block}__error`}>{config.error}</span>}
			</label>
		);
	})}

	<div class={`${block}__consents`}>
		<label class={`${block}__consent`} data-required-field data-invalid="false">
			<input class={`${block}__checkbox`} name="consent" type="checkbox" required />
			<span class={`${block}__checkbox-box`} aria-hidden="true">
				<svg class={`${block}__checkbox-check`} viewBox="0 0 20 13" fill="none" xmlns="http://www.w3.org/2000/svg">
					<path
						d="M0.725952 4.53682L7.61957 11.8134L18.726 0.707031"
						stroke="white"
						stroke-width="1.5"
						stroke-linecap="round"
						stroke-linejoin="round"
					/>
				</svg>
			</span>
			<span class={`${block}__consent-text`}>
				Отправляя заявку вы соглашаетесь с <a href="#privacy">условиями политики конфиденциальности и обработки персональных данных</a>
			</span>
		</label>

		<label class={`${block}__consent`} data-invalid="false">
			<input class={`${block}__checkbox`} name="marketingConsent" type="checkbox" />
			<span class={`${block}__checkbox-box`} aria-hidden="true">
				<svg class={`${block}__checkbox-check`} viewBox="0 0 20 13" fill="none" xmlns="http://www.w3.org/2000/svg">
					<path
						d="M0.725952 4.53682L7.61957 11.8134L18.726 0.707031"
						stroke="white"
						stroke-width="1.5"
						stroke-linecap="round"
						stroke-linejoin="round"
					/>
				</svg>
			</span>
			<span class={`${block}__consent-text`}>
				{marketingConsentText}
			</span>
		</label>
	</div>

	{button === 'ui' ? (
		<Button type="submit" variant={submitVariant} size={submitSize} class={submitClass}>
			{submitLabel}
		</Button>
	) : (
		<button class={submitClass} type="submit">{submitLabel}</button>
	)}
</form>
