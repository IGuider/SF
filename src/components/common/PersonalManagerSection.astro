---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import managerImage from '../../assets/manager-panel-bg.png';
import '../../styles/components/common/personal-manager-section.scss';

type Props = {
	id?: string;
	heading?: string;
	title?: string;
	titleLines?: string[];
	textLines?: string[];
	name?: string;
	role?: string;
	roleLines?: string[];
	image?: ImageMetadata;
	imageFit?: 'cover' | 'contain';
	breaksDesktopOnly?: boolean;
};

const {
	id = 'manager',
	heading = 'Персональный менеджер на весь процесс',
	title = 'Сопровождаю вас от заявки до исполнения контракта',
	titleLines,
	textLines = [
		'Помогу подобрать инструменты под ваш тендер, подскажу по сбору необходимых документов и объясню разницу в продуктах.',
		'Всегда на связи любым удобным способом',
	],
	name = 'Анна',
	role = 'менеджер по госзаказу',
	roleLines,
	image = managerImage,
	imageFit = 'cover',
	breaksDesktopOnly = false,
} = Astro.props;

const titleId = `${id}-title`;
const resolvedTitleLines = titleLines ?? [title];
const resolvedRoleLines = roleLines ?? [role];
---

<section class:list={['personal-manager', 'section', `personal-manager--${id}`]} id={id} aria-labelledby={titleId}>
	<div class="container">
		<div class="personal-manager__header section-header">
			<h2 class="section-title" id={titleId}>{heading}</h2>
		</div>

		<div class="personal-manager__panel">
			<div class="personal-manager__visual" aria-hidden="true">
				<Image
					class:list={['personal-manager__image', 'media-fill', `media-fit-${imageFit}`]}
					src={image}
					alt=""
					loading="lazy"
					decoding="async"
				/>
			</div>

			<div class="personal-manager__content">
				<h3 class="personal-manager__title">
					{resolvedTitleLines.map((line, index) => (
						<>
							{index > 0 && <><br class:list={{ 'desktop-only-break': breaksDesktopOnly }} />{breaksDesktopOnly && ' '}</>}
							{line}
						</>
					))}
				</h3>
				<p class="personal-manager__text">
					{
						textLines.map((line, index) => (
							<>
								{index > 0 && <><br class:list={{ 'desktop-only-break': breaksDesktopOnly }} />{breaksDesktopOnly && ' '}</>}
								{line}
							</>
						))
					}
				</p>
				<div class="personal-manager__author">
					<p class="personal-manager__name">{name}</p>
					<p class="personal-manager__role">
						{resolvedRoleLines.map((line, index) => (
							<>
								{index > 0 && <><br class="personal-manager__role-break" />{' '}</>}
								{line}
							</>
						))}
					</p>
				</div>
			</div>
		</div>
	</div>
</section>
