---
import { getCollection } from 'astro:content';
import '../../styles/components/common/steps-section.scss';
import ConsultationDialogTrigger from './ConsultationDialogTrigger.astro';
import Button from '../ui/Button.astro';

type StepItem = {
	id: string;
	number: string;
	title: string;
	description?: string;
	descriptionLines?: string[];
	ctaLabel?: string;
};

interface Props {
	variant?: 'default' | 'credit-line';
	title?: string;
	descriptionLines?: string[];
	steps?: StepItem[];
	breaksDesktopOnly?: boolean;
	descriptionBreaksDesktopOnly?: boolean;
	descriptionDesktopNoWrap?: boolean;
}

const {
	variant = 'default',
	title = 'Как получить финансирование',
	descriptionLines = [],
	steps: providedSteps,
	breaksDesktopOnly = false,
	descriptionBreaksDesktopOnly = breaksDesktopOnly,
	descriptionDesktopNoWrap = false,
}: Props = Astro.props;

const collectionSteps = providedSteps
	? []
	: (await getCollection('steps')).sort((left, right) => left.data.order - right.data.order);
const steps = providedSteps ?? collectionSteps.map((step) => ({
	id: step.id,
	number: step.data.number,
	title: step.data.title,
	description: step.data.description,
	ctaLabel: step.data.ctaLabel,
}));
const ctaStep = steps.find((step) => step.ctaLabel);
const sectionClass = ['steps-section', 'section', `steps-section--${variant}`].join(' ');
---

<section class={sectionClass} id="steps" aria-labelledby="steps-title">
	<div class="container">
		<div class="steps-section__header section-header section-header--spacious">
			<h2 class="steps-section__title section-title" id="steps-title">{title}</h2>
			{
				descriptionLines.length > 0 && (
					<p class:list={['steps-section__description', 'section-description', { 'desktop-only-nowrap': descriptionDesktopNoWrap }]}>
						{descriptionLines.map((line, index) => (
							<>
								{index > 0 && <><br class:list={{ 'desktop-only-break': descriptionBreaksDesktopOnly }} />{descriptionBreaksDesktopOnly && ' '}</>}
								{line}
							</>
						))}
					</p>
				)
			}
		</div>

		<div class="steps-section__timeline" aria-hidden="true">
			<div class="steps-section__timeline-track"></div>
			<div class="steps-section__timeline-fill"></div>
		</div>

		<div class="steps-section__grid">
			{
				steps.map((step) => (
					<article class="steps-card" aria-labelledby={`${step.id}-title`}>
						<div class="steps-card__number" aria-hidden="true" data-steps-number>
							{step.number}
						</div>
						<div class="steps-card__content">
							<h3 class="steps-card__title" id={`${step.id}-title`}>{step.title}</h3>
							<p class="steps-card__description">
								{(step.descriptionLines ?? [step.description]).map((line, index) => (
									<>
										{index > 0 && <><br class:list={{ 'desktop-only-break': breaksDesktopOnly }} />{breaksDesktopOnly && ' '}</>}
										{line}
									</>
								))}
							</p>
						</div>
					</article>
				))
			}
		</div>

		{
			ctaStep && (
				<div class="steps-section__actions">
					<ConsultationDialogTrigger>
						<Button variant="secondary" size="xl">{ctaStep.ctaLabel}</Button>
					</ConsultationDialogTrigger>
				</div>
			)
		}
	</div>
</section>

<script>
	import { runOnPageLoad } from '../../scripts/common/lifecycle';
	import { initStepsSection } from '../../scripts/common/steps-section';

	runOnPageLoad(initStepsSection);
</script>
