---
import { getCollection } from 'astro:content';
import logo from '../../assets/sf-logo.svg';
import menuDecorTop from '../../assets/menu-bg1.png';
import menuDecorBottom from '../../assets/menu-bg2.png';
import '../../styles/components/common/header.scss';
import ConsultationDialogTrigger from './ConsultationDialogTrigger.astro';
import Button from '../ui/Button.astro';
import SocialIcon from '../ui/SocialIcon.astro';

interface NavItem {
	label: string;
	href: string;
	children?: NavItem[];
}

interface Props {
	brandHref?: string;
	navItems?: NavItem[];
	mobileNavItems?: NavItem[];
}

const basePath = import.meta.env.BASE_URL.endsWith('/')
	? import.meta.env.BASE_URL
	: `${import.meta.env.BASE_URL}/`;

const defaultNavItems = [
	{ label: 'О компании', href: `${basePath}about/` },
	{ label: 'Продукты', href: `${basePath}products/` },
	{ label: 'Блог', href: `${basePath}blog/` },
	{ label: 'Контакты', href: `${basePath}contacts/` },
];

const productSubmenuItems: NavItem[] = [
	{
		label: 'Гос- и коммерческие закупки',
		href: `${basePath}goszakaz/`,
		children: [
			{ label: 'Банковская гарантия', href: `${basePath}bg/` },
			{ label: 'Тендерный заем', href: `${basePath}tendernyy-zaem/` },
			{ label: 'Исполнение контракта', href: `${basePath}goszakaz/` },
		],
	},
	{
		label: 'Поставщикам маркетплейсов',
		href: `${basePath}ecom/`,
	},
	{
		label: 'Агентам',
		href: 'https://platform.simplefinance.ru/',
	},
];

const withProductSubmenu = (items: NavItem[]) =>
	items.map((item) => {
		if (item.label !== 'Продукты' || item.children?.length) {
			return item;
		}

		return {
			...item,
			children: productSubmenuItems,
		};
	});

const socialLinks = (await getCollection('socialLinks'))
	.filter((item) => item.data.contexts.includes('header'))
	.sort((left, right) => left.data.order - right.data.order)
	.map((item) => item.data);

const {
	brandHref = basePath,
	navItems = defaultNavItems,
	mobileNavItems = navItems,
} = Astro.props;

const desktopNavItems = withProductSubmenu(navItems);
const mobileMenuItems = withProductSubmenu(mobileNavItems);
---

<header class="site-header">
	<div class="container site-header__inner">
		<a class="site-header__brand" href={brandHref} aria-label="SimpleFinance" transition:name="site-brand">
			<img class="site-header__logo" src={logo.src} alt="SimpleFinance" />
		</a>

		<button
			class="site-header__toggle"
			type="button"
			aria-expanded="false"
			aria-controls="site-header-menu"
			aria-label="Открыть меню"
		>
			<span class="site-header__toggle-line"></span>
			<span class="site-header__toggle-line"></span>
			<span class="site-header__toggle-line"></span>
		</button>

		<div class="site-header__menu" id="site-header-menu">
			<div class="site-header__menu-container">
				<nav class="site-header__nav" aria-label="Основная навигация">
					<ul class="site-header__nav-list site-header__nav-list--desktop">
						{
							desktopNavItems.map((item) => (
								<li class:list={['site-header__nav-item', item.children?.length && 'site-header__nav-item--has-submenu']}>
									<a
										class="site-header__nav-link"
										href={item.href}
										aria-haspopup={item.children?.length ? 'true' : undefined}
									>
										{item.label}
									</a>
									{item.children?.length && (
										<div class="site-header__submenu" aria-label={`Раздел ${item.label}`}>
											<ul class="site-header__submenu-list">
												{item.children.map((group) => (
													<li class="site-header__submenu-group">
														<a class="site-header__submenu-link site-header__submenu-link--group" href={group.href}>
															{group.label}
														</a>
														{group.children?.length && (
															<ul class="site-header__submenu-list site-header__submenu-list--nested">
																{group.children.map((child) => (
																	<li>
																		<a class="site-header__submenu-link site-header__submenu-link--child" href={child.href}>
																			{child.label}
																		</a>
																	</li>
																))}
															</ul>
														)}
													</li>
												))}
											</ul>
										</div>
									)}
								</li>
							))
						}
					</ul>

					<ul class="site-header__nav-list site-header__nav-list--mobile">
						{
							mobileMenuItems.map((item) => (
								<li class:list={['site-header__nav-item', item.children?.length && 'site-header__nav-item--has-submenu']}>
									<a class="site-header__nav-link" href={item.href}>{item.label}</a>
									{item.children?.length && (
										<div class="site-header__submenu" aria-label={`Раздел ${item.label}`}>
											<ul class="site-header__submenu-list">
												{item.children.map((group) => (
													<li class="site-header__submenu-group">
														<a class="site-header__submenu-link site-header__submenu-link--group" href={group.href}>
															{group.label}
														</a>
														{group.children?.length && (
															<ul class="site-header__submenu-list site-header__submenu-list--nested">
																{group.children.map((child) => (
																	<li>
																		<a class="site-header__submenu-link site-header__submenu-link--child" href={child.href}>
																			{child.label}
																		</a>
																	</li>
																))}
															</ul>
														)}
													</li>
												))}
											</ul>
										</div>
									)}
								</li>
							))
						}
					</ul>
				</nav>

				<div class="site-header__actions">
					<a class="site-header__phone" href="tel:+74951504011">+7 (495) 150-40-11</a>
					<ConsultationDialogTrigger>
						<Button variant="outline" class="site-header__button">Перезвоните мне</Button>
					</ConsultationDialogTrigger>
				</div>

				<div class="site-header__mobile-footer">
					<a class="site-header__mobile-phone" href="tel:+74951504011">+7 (495) 150-40-11</a>

					<ul class="site-header__socials" aria-label="Социальные сети">
						{
							socialLinks.map((item) => (
								<li>
									<a href={item.href} aria-label={item.label} target={item.href.startsWith('http') ? '_blank' : undefined} rel={item.href.startsWith('http') ? 'noreferrer' : undefined}>
										<SocialIcon icon={item.icon} />
									</a>
								</li>
							))
						}
					</ul>
				</div>
			</div>


		</div>
		<div class="site-header__decor" aria-hidden="true">
			<img class="site-header__decor-item site-header__decor-item--top" src={menuDecorTop.src} alt="" />
			<img class="site-header__decor-item site-header__decor-item--bottom" src={menuDecorBottom.src} alt="" />
		</div>
	</div>
</header>

<script>
	import { initActiveNav } from '../../scripts/common/active-nav';
	import { initHeaderMenu } from '../../scripts/common/header-menu';
	import { runOnPageLoad } from '../../scripts/common/lifecycle';

	runOnPageLoad(initHeaderMenu);
	runOnPageLoad(initActiveNav);
</script>
