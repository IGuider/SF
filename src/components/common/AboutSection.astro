---
import '../../styles/components/common/about-section.scss';

interface Props {
	paragraphs: string[];
	ariaLabel: string;
}

const { paragraphs, ariaLabel } = Astro.props;
---

<section class="about-section section" aria-label={ariaLabel}>
	<div class="container">
		<div class="about-section__content">
			{paragraphs.map((paragraph) => <p class="about-section__text">{paragraph}</p>)}
		</div>
	</div>
</section>
