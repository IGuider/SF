---
import '../../styles/components/common/about-section.scss';

interface Props {
	paragraphs: Array<string | string[]>;
	ariaLabel: string;
	breaksDesktopOnly?: boolean;
	id?: string;
	tone?: 'primary' | 'strong';
	variant?: 'default' | 'company';
}

const {
	paragraphs,
	ariaLabel,
	breaksDesktopOnly = false,
	id,
	tone = 'primary',
	variant = 'default',
} = Astro.props;
---

<section
	class:list={['about-section', 'section', `about-section--${tone}`, { 'about-section--company': variant === 'company' }]}
	id={id}
	aria-label={ariaLabel}
>
	<div class="container">
		<div class="about-section__content">
			{paragraphs.map((paragraph) => (
				<p class="about-section__text">
					{(Array.isArray(paragraph) ? paragraph : [paragraph]).map((line, index) => (
						<>
							{index > 0 && <><br class:list={{ 'desktop-only-break': breaksDesktopOnly }} />{breaksDesktopOnly && ' '}</>}
							{line}
						</>
					))}
				</p>
			))}
		</div>
	</div>
</section>
