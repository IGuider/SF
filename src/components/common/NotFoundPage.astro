---
import notFoundImage from '../../assets/404bg.svg';
import '../../styles/components/common/not-found-page.scss';
import Button from '../ui/Button.astro';

const basePath = import.meta.env.BASE_URL.endsWith('/')
	? import.meta.env.BASE_URL
	: `${import.meta.env.BASE_URL}/`;
---

<main class="not-found-page" transition:name="page-content">
	<section class="container not-found-page__inner" aria-labelledby="not-found-title">
		<img
			class="not-found-page__image"
			src={notFoundImage.src}
			alt=""
			loading="eager"
			decoding="async"
		/>

		<div class="not-found-page__content">
			<div class="not-found-page__copy">
				<h1 class="not-found-page__title" id="not-found-title">Страница не найдена</h1>
				<p class="not-found-page__text">
					Ссылка устарела или была перемещена. Вернитесь на главную и выберите нужный раздел
				</p>
			</div>

			<Button as="a" href={basePath} variant="secondary" size="xl" class="not-found-page__button">
				На главную
			</Button>
		</div>
	</section>
</main>
