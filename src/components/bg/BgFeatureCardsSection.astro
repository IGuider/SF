---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import featureBg1 from '../../assets/bg/feature-bg1.png';
import featureBg1Mobile from '../../assets/bg/feature-bg1-m.png';
import featureBg2 from '../../assets/bg/feature-bg2.png';
import featureBg2Mobile from '../../assets/bg/feature-bg2-m.png';
import featureBg3 from '../../assets/bg/feature-bg3.png';
import featureBg3Mobile from '../../assets/bg/feature-bg3-m.png';
import featureBg4 from '../../assets/bg/feature-bg4.png';
import featureBg4Mobile from '../../assets/bg/feature-bg4-m.png';
import featureBg5 from '../../assets/bg/feature-bg5.png';
import featureBg5Mobile from '../../assets/bg/feature-bg5-m.png';
import ConsultationDialogTrigger from '../common/ConsultationDialogTrigger.astro';
import Button from '../ui/Button.astro';
import '../../styles/components/bg/feature-cards-section.scss';

type BgCardModifier = 'geography' | 'speed' | 'amount' | 'documents' | 'installment';

type BgCardImageConfig = {
	image: ImageMetadata;
	mobileImage?: ImageMetadata;
	loading: 'eager' | 'lazy';
};

const cardImages: Record<BgCardModifier, BgCardImageConfig> = {
	geography: { image: featureBg1, mobileImage: featureBg1Mobile, loading: 'eager' },
	speed: { image: featureBg2, mobileImage: featureBg2Mobile, loading: 'eager' },
	amount: { image: featureBg3, mobileImage: featureBg3Mobile, loading: 'lazy' },
	documents: { image: featureBg4, mobileImage: featureBg4Mobile, loading: 'lazy' },
	installment: { image: featureBg5, mobileImage: featureBg5Mobile, loading: 'lazy' },
};

const cards = (await getCollection('bgFeatureCards'))
	.sort((left, right) => left.data.order - right.data.order)
	.map((item) => ({
		...item.data,
		...cardImages[item.data.modifier],
	}));
---

<section class="bg-feature-cards section" id="guarantee-benefits" aria-label="Преимущества банковской гарантии">
	<div class="container">
		<div class="bg-feature-cards__grid">
			{
				cards.map((card) => (
					<article class:list={['bg-feature-card', `bg-feature-card--${card.modifier}`]}>
						<div class="bg-feature-card__content">
							<h2 class="bg-feature-card__title">{card.title}</h2>
							<p class="bg-feature-card__text">
								{card.textLines.map((line, index) => (
									<>
										<span class="bg-feature-card__text-line">{line}</span>
										{index < card.textLines.length - 1 && ' '}
									</>
								))}
							</p>
						</div>

						<div class:list={['bg-feature-card__media', `bg-feature-card__media--${card.modifier}`]} aria-hidden="true">
							{
								card.mobileImage ? (
									<picture>
										<source srcset={card.mobileImage.src} media="(max-width: 768px)" />
										<Image
											class="bg-feature-card__image media-fill media-fit-contain"
											src={card.image}
											alt=""
											loading={card.loading}
											decoding="async"
										/>
									</picture>
								) : (
									<Image
										class="bg-feature-card__image media-fill media-fit-contain"
										src={card.image}
										alt=""
										loading={card.loading}
										decoding="async"
									/>
								)
							}
						</div>

						{
							card.ctaLabel && (
								<ConsultationDialogTrigger>
									<Button variant="secondary" size="lg" class="bg-feature-card__button">
										{card.ctaLabel}
									</Button>
								</ConsultationDialogTrigger>
							)
						}
					</article>
				))
			}
		</div>
	</div>
</section>
