---
import DirectionsSection from './DirectionsSection.astro';
import CompanyFactsSection from './CompanyFactsSection.astro';
import CompanyStatsSection from '../common/CompanyStatsSection.astro';
import BlogSection from '../common/BlogSection.astro';
import FaqSection from '../common/FaqSection.astro';
import LeadFormSection from '../common/LeadFormSection.astro';
import MissionSection from './MissionSection.astro';
import WhyTrustSection from './WhyTrustSection.astro';
import HeroSection from '../common/HeroSection.astro';
import StepsSection from '../common/StepsSection.astro';
import AboutSection from '../common/AboutSection.astro';
import heroHomeImage from '../../assets/hero-home.jpg';

const homeSteps = [
	{
		id: 'request',
		number: '01',
		title: 'Заявка',
		descriptionLines: ['Оставьте заявку на\u00A0сайте:', 'потребуется всего', 'несколько минут'],
	},
	{
		id: 'review',
		number: '02',
		title: 'Рассмотрение',
		descriptionLines: ['Проверим данные', 'и\u00A0подготовим предложение'],
	},
	{
		id: 'offer',
		number: '03',
		title: 'Предложение',
		descriptionLines: ['Подберем', 'финансовое решение', 'и\u00A0согласуем условия'],
	},
	{
		id: 'payout',
		number: '04',
		title: 'Выдача',
		descriptionLines: ['Перечислим средства', 'после\u00A0подписания', 'документов'],
		ctaLabel: 'Оставить заявку',
	},
];

const homeAboutParagraphs = [
	'SimpleFinance — финансовая платформа для\u00A0бизнеса, которая помогает предпринимателям и\u00A0компаниям привлекать финансирование для\u00A0развития, пополнения оборотных средств, исполнения контрактов, участия в\u00A0государственных и\u00A0коммерческих закупках, а\u00A0также работы на\u00A0маркетплейсах. Мы объединяем современные финансовые инструменты для\u00A0бизнеса в\u00A0одном сервисе, помогая подобрать оптимальное решение под\u00A0конкретные задачи компании',
	[
		'На\u00A0платформе доступны банковские гарантии, тендерные займы, финансирование исполнения контрактов, решения для\u00A0поставщиков и\u00A0продавцов маркетплейсов, а\u00A0также другие продукты для\u00A0малого и\u00A0среднего бизнеса. Благодаря полностью онлайн-оформлению, собственной технологической платформе',
		'и\u00A0сотрудничеству с\u00A0финансовыми организациями SimpleFinance помогает получить финансирование бизнеса быстрее и\u00A0сосредоточиться на\u00A0развитии компании',
	],
];
---

<main transition:name="page-content" transition:animate="fade">
	<HeroSection
		variant="home"
		titleLines={['Финансирование,', 'которое помогает', 'бизнесу расти']}
		descriptionLines={[
			'Помогаем получить финансирование для\u00A0развития',
			'компании, участия в\u00A0государственных закупках,',
			'исполнения контрактов и работы на маркетплейсах',
		]}
		descriptionBreaksDesktopOnly
		buttonLabel="Подобрать решение"
		buttonVariant="secondary"
		image={heroHomeImage}
	/>
	<DirectionsSection />
	<WhyTrustSection />
	<MissionSection />
	<CompanyFactsSection />
	<CompanyStatsSection />
	<StepsSection
		descriptionLines={['Получить финансирование можно полностью онлайн — от\u00A0подачи заявки до\u00A0получения денежных средств']}
		steps={homeSteps}
		breaksDesktopOnly
	/>
	<LeadFormSection
		descriptionLines={[
			'Оставьте заявку, и мы предложим финансовый инструмент,',
			'который поможет решить задачи вашей компании',
		]}
		descriptionBreaksDesktopOnly
	/>
	<BlogSection />
	<AboutSection paragraphs={homeAboutParagraphs} ariaLabel="О платформе SimpleFinance" breaksDesktopOnly />
	<FaqSection collection="homeFaq" />
</main>
