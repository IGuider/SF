---
import HeroSection from '../common/HeroSection.astro';
import FaqSection from '../common/FaqSection.astro';
import LeadFormSection from '../common/LeadFormSection.astro';
import StepsSection from '../common/StepsSection.astro';
import IconFeaturesSection from '../common/IconFeaturesSection.astro';
import AboutSection from '../common/AboutSection.astro';
import ParticipationSection from './ParticipationSection.astro';
import heroTenderLoanImage from '../../assets/tz-home.jpg';

const tenderLoanBadges = ['до 500 млн ₽', 'от 3% в месяц', 'до 60 дней', 'онлайн'];
const tenderLoanAboutParagraphs = [
	'Тендерный заем — это инструмент финансирования для компаний, участвующих в закупках. Он помогает обеспечить заявку, сохранить собственные оборотные средства и не откладывать участие в тендере из‑за временной нехватки денег',
	'Такой формат подходит поставщикам, подрядчикам, производителям и сервисным компаниям, которые работают с закупками по 44‑ФЗ, 223‑ФЗ, 185‑ФЗ, 615‑ПП или участвуют в коммерческих тендерах. Средства могут использоваться для обеспечения заявки, а также для запуска исполнения контракта после победы в закупке',
	'SimpleFinance предоставляет тендерное финансирование онлайн и помогает подобрать условия с учетом параметров закупки, финансового профиля компании и сроков подачи заявки',
];
const tenderLoanSteps = [
	{
		id: 'tender-loan-request',
		number: '01',
		title: 'Заявка',
		description: 'Оставьте заявку на сайте: 2 минуты на заполнение',
	},
	{
		id: 'tender-loan-review',
		number: '02',
		title: 'Рассмотрение',
		description: 'Получите предварительное решение',
	},
	{
		id: 'tender-loan-offer',
		number: '03',
		title: 'Предложение',
		description: 'Подпишите документы и оплатите комиссию',
	},
	{
		id: 'tender-loan-payout',
		number: '04',
		title: 'Выдача',
		description: 'Напрямую на спецсчет или счет площадки',
		ctaLabel: 'Оставить заявку',
	},
];
---

<main transition:name="page-content" transition:animate="fade">
	<HeroSection
		variant="tender-loan"
		titleLines={['Тендерный заем', 'на обеспечение заявки', 'и исполнение контракта']}
		titleBreaksDesktopOnly
		descriptionLines={['Предоставляем финансирование для участия', 'в государственных и коммерческих закупках']}
		descriptionBreaksDesktopOnly
		badges={tenderLoanBadges}
		badgesPosition="afterText"
		badgesLabel="Условия тендерного займа"
		badgeVariant="outline-primary"
		buttonLabel="Подобрать решение"
		buttonVariant="secondary"
		image={heroTenderLoanImage}
	/>
	<ParticipationSection />
	<IconFeaturesSection
		group="tender-loan"
		title="Когда бизнесу нужен тендерный заем"
		description="Тендерный заем помогает получить финансирование для участия в государственных и коммерческих закупках, сохранив собственные средства для текущей деятельности компании"
	/>
	<StepsSection
		title="Как проходит оформление тендерного займа"
		descriptionLines={[
			'Такой порядок удобен для компаний, которым важно не пропустить срок подачи заявки',
			'и при этом сохранить собственные оборотные средства для текущей деятельности',
		]}
		steps={tenderLoanSteps}
	/>
	<FaqSection collection="tenderLoanFaq" />
	<AboutSection paragraphs={tenderLoanAboutParagraphs} ariaLabel="О тендерном займе" />
	<LeadFormSection />
</main>
