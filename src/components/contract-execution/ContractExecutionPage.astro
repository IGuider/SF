---
import HeroSection from '../common/HeroSection.astro';
import CompanyStatsSection from '../common/CompanyStatsSection.astro';
import IconFeaturesSection from '../common/IconFeaturesSection.astro';
import StepsSection from '../common/StepsSection.astro';
import PersonalManagerSection from '../common/PersonalManagerSection.astro';
import FaqSection from '../common/FaqSection.astro';
import AboutSection from '../common/AboutSection.astro';
import LeadFormSection from '../common/LeadFormSection.astro';
import heroContractExecutionImage from '../../assets/hero-ipsk.jpg';
import contractExecutionManagerImage from '../../assets/manager-ispk-panel-bg.png';

const contractExecutionBadges = ['44-ФЗ', '223-ФЗ', '185-ФЗ и 615-ПП'];
const contractExecutionAboutParagraphs = [
	'Заем на исполнение контракта помогает поставщикам, подрядчикам и исполнителям услуг получить деньги на выполнение обязательств после победы в закупке. Финансирование может понадобиться, если нужно заранее закупить товар, оплатить материалы, логистику, работу подрядчиков или подготовить производство, а оплата от заказчика поступит позже',
	'Такой формат подходит компаниям, которым нужны средства на исполнение государственного контракта, финансирование госконтракта по 44-ФЗ или деньги под коммерческий контракт. Заем помогает закрыть кассовый разрыв, сохранить оборотные средства и начать работы без задержек',
	'SimpleFinance подбирает финансирование под параметры конкретного контракта: сумму, сроки исполнения, условия оплаты и требования заказчика. Заявку можно подать онлайн, а предварительное решение получить после рассмотрения данных по контракту',
];
const contractExecutionSteps = [
	{
		id: 'contract-execution-line',
		number: '01',
		title: 'Открываете линию',
		descriptionLines: ['Один раз, один договор.', 'Одобренный лимит,', 'например, 20 млн ₽'],
	},
	{
		id: 'contract-execution-tranche',
		number: '02',
		title: 'Транш на контракт',
		descriptionLines: ['Выиграли тендер —', 'берете 8 млн ₽.', 'Остаток 12 млн ₽'],
	},
	{
		id: 'contract-execution-payment',
		number: '03',
		title: 'Заказчик оплатил',
		descriptionLines: ['Вернули 8 млн ₽.', 'Лимит обновился', 'на 20 млн ₽'],
	},
	{
		id: 'contract-execution-next-tranche',
		number: '04',
		title: 'Следующий транш',
		descriptionLines: ['Новый контракт —', 'новый транш', 'новых заявок'],
		ctaLabel: 'Оставить заявку',
	},
];
---

<main transition:name="page-content" transition:animate="fade">
	<HeroSection
		variant="contract-execution"
		titleLines={['Заем на исполнение', 'контракта за 2 дня']}
		descriptionLines={[
			'Финансирование для государственного',
			'или коммерческого контракта без отвлечения',
			'оборотных средств',
		]}
		badges={contractExecutionBadges}
		badgesPosition="afterText"
		badgesLabel="Поддерживаемые виды закупок"
		badgeVariant="outline-primary"
		buttonLabel="Подобрать решение"
		buttonVariant="secondary"
		image={heroContractExecutionImage}
	/>
	<CompanyStatsSection
		id="contract-execution-stats"
		title="Преимущества"
		collectionName="contractExecutionStats"
	/>
	<IconFeaturesSection
		group="contract-execution"
		title="Прозрачные условия без скрытых комиссий"
		description="Получите средства на исполнение контракта, закупку материалов, оплату поставщиков и запуск работ до поступления оплаты от заказчика"
	/>
	<StepsSection
		variant="credit-line"
		title="Как работает возобновляемая линия"
		descriptionLines={[
			'Возобновляемая кредитная линия позволяет получать финансирование на исполнение государственных',
			'и коммерческих контрактов без повторного оформления документов по каждому новому проекту',
		]}
		steps={contractExecutionSteps}
	/>
	<PersonalManagerSection
		id="contract-execution-manager"
		heading="Персональный менеджер на весь процесс"
		titleLines={[
			'От заявки до исполнения контракта',
			'вас сопровождает один специалист',
		]}
		textLines={[
			'Менеджер поможет рассчитать условия займа, подготовить',
			'заявку, сориентирует по документам и подберет финансирование',
			'под параметры государственного или коммерческого контракта',
		]}
		name="Екатерина"
		role="менеджер по тендерным займам"
		image={contractExecutionManagerImage}
		imageFit="contain"
	/>
	<FaqSection collection="contractExecutionFaq" />
	<AboutSection
		paragraphs={contractExecutionAboutParagraphs}
		ariaLabel="О займе на исполнение контракта"
	/>
	<LeadFormSection />
</main>
