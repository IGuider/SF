---
import SiteShell from '../components/common/SiteShell.astro';
import DocumentsPage from '../components/common/DocumentsPage.astro';

const basePath = import.meta.env.BASE_URL.endsWith('/')
	? import.meta.env.BASE_URL
	: `${import.meta.env.BASE_URL}/`;

const documentsNavItems = [
	{ label: 'О компании', href: `${basePath}about/` },
	{ label: 'Продукты', href: `${basePath}products/` },
	{ label: 'Блог', href: `${basePath}blog/` },
	{ label: 'Контакты', href: `${basePath}contacts/` },
];
---

<SiteShell
	title="Юридические документы SimpleFinance"
	description="Юридические документы SimpleFinance: лицензии, уставные документы, политики, правила и дополнительные контакты."
	headerBrandHref={basePath}
	headerNavItems={documentsNavItems}
	headerMobileNavItems={documentsNavItems}
>
	<DocumentsPage />
</SiteShell>
