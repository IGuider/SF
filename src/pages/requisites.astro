---
import SiteShell from '../components/common/SiteShell.astro';
import RequisitesPage from '../components/common/RequisitesPage.astro';

const basePath = import.meta.env.BASE_URL.endsWith('/')
	? import.meta.env.BASE_URL
	: `${import.meta.env.BASE_URL}/`;

const requisitesNavItems = [
	{ label: 'О компании', href: `${basePath}about/` },
	{ label: 'Продукты', href: `${basePath}products/` },
	{ label: 'Блог', href: `${basePath}blog/` },
	{ label: 'Контакты', href: `${basePath}contacts/` },
];
---

<SiteShell
	title="Реквизиты SimpleFinance"
	description="Реквизиты ООО МКК «СимплФинанс»: юридический адрес, контакты, ИНН, КПП, ОГРН и банковские реквизиты."
	headerBrandHref={basePath}
	headerNavItems={requisitesNavItems}
	headerMobileNavItems={requisitesNavItems}
>
	<RequisitesPage />
</SiteShell>
